# archives
*.zip
*.7z
*.rar
*.tar
*.tar.gz

# build / deps
node_modules/
dist/

# deploy-time build identifier — injected by the Pages workflow, never committed
# (a committed hash goes stale on the next commit and lies)
rsc-designer/version.json

# OS cruft
Thumbs.db
Desktop.ini
.DS_Store

# local tool permissions — machine-specific, not repo content
.claude/settings.local.json
